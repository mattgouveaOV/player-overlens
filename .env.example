# =============================================================================
# player-overlens — Player de salas ao vivo (LiveKit) do ecossistema Vanguarda
# Copie para `.env.local` e preencha. Dev roda na porta 3001.
#
# TODAS as variáveis abaixo são OBRIGATÓRIAS: `src/lib/env.ts` valida com Zod no
# boot e lança erro se qualquer uma estiver ausente/inválida. Não há opcionais.
# =============================================================================


# ──────────────────────────────────────────────────────────────────────────
# Supabase (org Overlens — mesmo projeto do ecossistema Vanguarda)
# ──────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://fpzfxuteayzlgoehirpd.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Service role — usado no server para autorizar tokens de sala. NUNCA expor no client.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here


# ──────────────────────────────────────────────────────────────────────────
# LiveKit Cloud — mídia em tempo real (áudio/vídeo das salas)
# ──────────────────────────────────────────────────────────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret


# ──────────────────────────────────────────────────────────────────────────
# URLs do ecossistema
# ──────────────────────────────────────────────────────────────────────────

# URL pública do próprio Player (exigida pelo schema de env).
# Local: http://localhost:3001 · Prod: https://player.overlens.com.br
NEXT_PUBLIC_PLAYER_URL=https://player-vanguarda.overlens.com.br

# URL da área secreta — redirecionamentos de saída/login e links de volta.
# Local: http://localhost:3003 · Prod: https://app.overlens.com.br
NEXT_PUBLIC_AREA_SECRETA_URL=https://vanguarda.overlens.com.br
